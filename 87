<!doctype html>
<html lang="zh-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>圖片 + 音效 x2</title>
  <style>
    html,body{height:100%;margin:0;display:flex;align-items:center;justify-content:center;background:#000}
    img{max-width:100%;height:auto;display:block}
    .controls{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);display:flex;gap:8px}
    button{padding:8px 12px;font-size:14px;border-radius:6px;border:0;background:#1a73e8;color:#fff;cursor:pointer}
  </style>
</head>
<body>
  <img id="img" src="https://stickershop.line-scdn.net/stickershop/v1/sticker/417848475/iPhone/sticker_animation@2x.png" alt="image">
  <div class="controls">
    <button id="playBtn">播放音效 x2</button>
    <button id="stopBtn">停止</button>
  </div>

  <audio id="sfx" src="https://stickershop.line-scdn.net/stickershop/v1/sticker/417848475/android/sticker_sound.m4a" preload="auto"></audio>

  <script>
    const audio = document.getElementById('sfx');
    const playBtn = document.getElementById('playBtn');
    const stopBtn = document.getElementById('stopBtn');

    const targetPlays = 2;
    let playCount = 0;
    let playing = false;

    // 當音效結束時，若尚未達到目標次數則繼續播放
    audio.addEventListener('ended', () => {
      if (playCount < targetPlays) {
        audio.currentTime = 0;
        audio.play().catch(()=>{});
      } else {
        playing = false;
      }
    });

    // 每次開始播放時記錄次數
    audio.addEventListener('play', () => {
      // 若 play event 在中途被重複觸發，確保只在真正開始時計數
      if (audio.currentTime === 0) {
        playCount++;
      }
    });

    // 啟動播放（從頭開始，重置計數）
    async function startPlayTwice() {
      playCount = 0;
      playing = true;
      audio.currentTime = 0;
      try {
        await audio.play();
      } catch (e) {
        // 瀏覽器可能阻擋自動播放，等使用者按鈕
      }
    }

    playBtn.addEventListener('click', () => startPlayTwice());

    stopBtn.addEventListener('click', () => {
      playing = false;
      playCount = targetPlays; // 阻止後續自動重播
      audio.pause();
      audio.currentTime = 0;
    });

    // 若希望嘗試在圖片載入時自動播放（仍可能被瀏覽器策略阻擋）
    document.getElementById('img').addEventListener('load', () => {
      startPlayTwice();
    });
  </script>
</body>
</html>
